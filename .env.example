# copy this file to .env and fill it in. never commit .env

# ---- required: app secrets ----
# generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=""
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# don't change this after users have saved api keys, or they can't be decrypted
ENCRYPTION_KEY=""

# ---- database ----
# postgres. documents need the pgvector extension (supabase and neon include it).
# on supabase use the "session pooler" connection string, which works over ipv4.
# if the password contains @ : / write them as %40 %3A %2F.
# leave empty to use a local sqlite file (chat works; documents are turned off)
DATABASE_URL="postgresql+psycopg://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# ---- documents ----
# original pdfs go to supabase storage when these are set (project settings -> api);
# otherwise to backend/uploads, which free hosts wipe on restart
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
# DOC_MAX_MB="25"
# DOC_MAX_PAGES="500"
# DOC_MAX_PER_USER="20"
# DOC_TOP_K="6"               # passages given to the model per question

# ---- free models ----
# users without their own keys can chat with the hugging face models through
# this token. it also writes chat titles and summaries and embeds documents.
# usage is billed to it
HF_TOKEN=""
FREE_MODELS_ENABLED="true"
FREE_DAILY_LIMIT="50"

# ---- server provider keys (optional) ----
# used by the terminal chat (backend/cli.py), and by the web app only when
# ALLOW_SERVER_KEYS is true. keep that false if other people can sign up
ALLOW_SERVER_KEYS="false"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
XAI_API_KEY=""
GOOGLE_API_KEY=""
DEEPSEEK_API_KEY=""

# ---- optional ----
# COOKIE_SECURE="true"        # when served over https
# SESSION_DAYS="7"
# MAX_HISTORY_MESSAGES="30"   # messages sent to the model per turn
